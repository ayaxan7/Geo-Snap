    <!-- Permissions screen -->
    <string name="permissions_title">App Permissions</string>
    <string name="permissions_subtitle_header">We need the following permissions to use Geo Snap</string>
    <string name="permissions_subtitle">These permissions help Geo Snap capture photos and videos with accurate location details.</string>
    <string name="permissions_open_settings">Open Settings</string>
    <string name="permissions_permanently_denied">Permanently denied — enable it in Settings</string>
    <string name="permissions_agree">I agree to the Permissions, Terms &amp; Conditions, and Privacy Policy.</string>
