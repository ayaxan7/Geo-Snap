<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Pending captures awaiting preview/save (see CameraXController.TEMP_DIR). -->
    <cache-path
        name="camera_temp"
        path="geosnap_camera/" />
    <!-- Internal media copies (see MediaRepositoryImpl.persistInternal). -->
    <files-path
        name="app_media"
        path="GeoSnap/" />
    <files-path
        name="app_media_patashot"
        path="Patashot/" />
    <files-path
        name="app_originals"
        path="originals/" />
    <files-path
        name="all_files"
        path="." />
    <!-- Burnt copies prepared for sharing (see MediaRepositoryImpl.prepareShareCopy). -->
    <cache-path
        name="share_cache"
        path="share/" />
</paths>
