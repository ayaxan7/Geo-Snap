    <string name="permissions_subtitle_header">GeoSnap का उपयोग करने के लिए हमें निम्नलिखित अनुमतियों की आवश्यकता है</string>
    <string name="permissions_subtitle">ये अनुमतियाँ GeoSnap को सटीक स्थान जानकारी के साथ फ़ोटो और वीडियो कैप्चर करने में मदद करती हैं।</string>
    <string name="permissions_open_settings">सेटिंग खोलें</string>
    <string name="permissions_permanently_denied">स्थायी रूप से अस्वीकृत — सेटिंग में इसे चालू करें</string>
    <string name="permissions_agree">मैं अनुमतियों, नियम और शर्तों तथा गोपनीयता नीति से सहमत हूँ।</string>
    <string name="permissions_get_started">आरंभ करें</string>

    <string name="permission_camera_label">कैमरा</string>
    <string name="permission_camera_description">GeoSnap को फ़ोटो लेने और वीडियो रिकॉर्ड करने के लिए आपके कैमरे का उपयोग करने की अनुमति देता है। यह अनुमति ऐप की मुख्य कैमरा सुविधाओं के लिए आवश्यक है।</string>
    <string name="permission_microphone_label">माइक्रोफ़ोन</string>
    <string name="permission_microphone_description">GeoSnap को वीडियो कैप्चर करते समय ऑडियो रिकॉर्ड करने की अनुमति देता है। इस अनुमति का उपयोग केवल ध्वनि के साथ वीडियो रिकॉर्ड करते समय किया जाता है।</string>
    <string name="permission_location_label">लोकेशन की पहुँच</string>
    <string name="permission_location_description">GeoSnap को आपकी वर्तमान लोकेशन का पता लगाने और आपकी तस्वीरों तथा वीडियो में आपका पता, निर्देशांक और GPS सटीकता जैसी जानकारी जोड़ने की अनुमति देता है।</string>
    <string name="permission_storage_label">फ़ोटो और मीडिया की पहुँच</string>
    <string name="permission_storage_description">आपको कैप्चर किए गए फ़ोटो और वीडियो को अपने डिवाइस पर सहेजने तथा संपादन, लोकेशन अपडेट या साझा करने के लिए मौजूदा फ़ोटो चुनने की अनुमति देता है।</string>
    <string name="permission_notifications_label">सूचनाएँ</string>
    <string name="permission_notifications_description">GeoSnap को महत्वपूर्ण अपडेट, रिमाइंडर और सदस्यता जानकारी भेजने की अनुमति देता है</string>

