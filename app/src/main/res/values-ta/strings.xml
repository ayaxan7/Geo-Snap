    <string name="permissions_title">பயன்பாட்டு அனுமதிகள்</string>
    <string name="permissions_subtitle_header">GeoSnap-ஐப் பயன்படுத்த கீழ்க்கண்ட அனுமதிகள் தேவை</string>
    <string name="permissions_subtitle">இந்த அனுமதிகள், GeoSnap புகைப்படங்கள் மற்றும் வீடியோக்களை துல்லியமான இருப்பிட விவரங்களுடன் எடுக்க உதவுகின்றன.</string>
    <string name="permissions_open_settings">அமைப்புகளைத் திற</string>
    <string name="permissions_permanently_denied">நிரந்தரமாக மறுக்கப்பட்டது — அமைப்புகளில் இயக்கவும்</string>
    <string name="permissions_agree">அனுமதிகள், விதிமுறைகள் &amp; நிபந்தனைகள் மற்றும் தனியுரிமைக் கொள்கைக்கு நான் ஒப்புக்கொள்கிறேன்.</string>
    <string name="permissions_get_started">தொடங்குவோம்</string>

    <string name="permission_camera_label">கேமரா</string>
    <string name="permission_camera_description">புகைப்படங்களை எடுக்க மற்றும் வீடியோக்களைப் பதிவுசெய்ய GeoSnap உங்கள் கேமராவைப் பயன்படுத்த அனுமதிக்கிறது. பயன்பாட்டின் முக்கிய கேமரா அம்சங்களுக்கு இந்த அனுமதி தேவை.</string>
    <string name="permission_microphone_label">மைக்ரோஃபோன்</string>
    <string name="permission_microphone_description">வீடியோக்களைப் பதிவு செய்யும்போது GeoSnap ஒலியைப் பதிவுசெய்ய அனுமதிக்கிறது. இந்த அனுமதி ஒலியுடன் வீடியோ பதிவுசெய்யும்போது மட்டுமே பயன்படுத்தப்படுகிறது.</string>
    <string name="permission_location_label">இருப்பிட அணுகல்</string>
    <string name="permission_location_description">உங்கள் தற்போதைய இருப்பிடத்தைக் கண்டறிந்து, உங்கள் முகவரி, ஆயங்கள் மற்றும் GPS துல்லியம் போன்ற விவரங்களை உங்கள் புகைப்படங்கள் மற்றும் வீடியோக்களில் சேர்க்க GeoSnap-க்கு அனுமதிக்கிறது.</string>
    <string name="permission_storage_label">புகைப்படங்கள் &amp; மீடியா அணுகல்</string>
    <string name="permission_storage_description">எடுக்கப்பட்ட புகைப்படங்கள் மற்றும் வீடியோக்களை உங்கள் சாதனத்தில் சேமிக்கவும், எடிட்டிங், இருப்பிட புதுப்பிப்புகள் அல்லது பகிர்வுக்குப் பயன்படுத்த ஏற்கனவே உள்ள புகைப்படங்களைத் தேர்ந்தெடுக்கவும் இது உங்களை அனுமதிக்கிறது.</string>
    <string name="permission_notifications_label">அறிவிப்புகள்</string>
    <string name="permission_notifications_description">முக்கியமான புதுப்பிப்புகள், நினைவூட்டல்கள் மற்றும் சந்தாதார் தகவல்களை GeoSnap அனுப்ப அனுமதிக்கிறது</string>

    <string name="location_dialog_title">இருப்பிடம் அணைக்கப்பட்டுள்ளது</string>
    <string name="location_dialog_message">புகைப்படங்கள் மற்றும் வீடியோக்களை GPS ஆயங்களுடன் குறியிட GeoSnap-க்கு உங்கள் சாதன இருப்பிடம் தேவை. தொடர இருப்பிடத்தை இயக்கவும்.</string>
